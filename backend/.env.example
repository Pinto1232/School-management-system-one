DB_URI=mongodb://127.0.0.1:27017/school-system
PORT=3001
KEYCLOAK_ISSUER=http://localhost:8081/realms/school-system
KEYCLOAK_AUDIENCE=school-system-api
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100

# Optional application email. Keep real credentials in backend/.env only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Existing payment integrations, when used
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://127.0.0.1:3000/subscribe
